% gnossienne-chords: the chord symbols of "Gnossienne No. 1-C_Instruments.pdf", read and placed on the
% card by muertos/tools/pdfchords.py (muertos/chords.sh --write); do not
% hand-edit. Concert pitch: Songs.ily's \transpose f c' writes them for
% the F mellophone with the notes. 6 placed, 0 left out.
gnossienne-chords = \chordmode {
	f1*6:m  % m1 F-
	c1:m  % m7 C-
	f\breve:m  % m8 F-
	bes\breve:m  % m10 B♭-
	f\breve:m  % m12 F-
	f1*10:m  % m14 F-
}
