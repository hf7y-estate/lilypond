% gs ... -sIN=cards.pdf letter-2up.ps : 5.5x4.25in cards two to a sheet on
% the top half of landscape letter (11x8.5in), slots (0,306)-(396,612) and
% (396,306)-(792,612) in PDF points; the bottom half is left blank for the
% lyre clip. Dashed cut lines at x=396 (top half only) and y=306.
IN (r) file runpdfbegin
/N pdfpagecount def
1 2 N {
  /i exch def
  0 1 1 {
    /k exch def
    i k add N le {
      gsave k 396 mul 306 translate
      PDFFile i k add 1 sub .PDFDrawPage
      grestore
    } if
  } for
  gsave 0.4 setlinewidth [3 3] 0 setdash 0.5 setgray
  396 306 moveto 396 612 lineto stroke
  0 306 moveto 792 306 lineto stroke grestore
  showpage
} for
runpdfend
