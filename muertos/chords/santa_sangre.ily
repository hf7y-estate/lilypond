% santa_sangre-chords: the chord symbols of "Santa Sangre-C_Instruments.pdf", read and placed on the
% card by muertos/tools/pdfchords.py (muertos/chords.sh --write); do not
% hand-edit. Concert pitch: Songs.ily's \transpose f c' writes them for
% the F mellophone with the notes. 7 placed, 0 left out.
santa_sangre-chords = \chordmode {
	s2.
	bes\breve  % m1 B♭
	f1*4:7  % m3 F7
	bes1*4  % m7 B♭
	c\breve:m  % m11 C-
	bes1  % m13 B♭
	f1:7  % m14 F7
	bes1*5/4  % m15 B♭
}
