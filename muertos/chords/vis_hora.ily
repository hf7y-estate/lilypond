% vis_hora-chords: the chord symbols of "Vi_s Hora-C_Instruments.pdf", read and placed on the
% card by muertos/tools/pdfchords.py (muertos/chords.sh --write); do not
% hand-edit. Concert pitch: Songs.ily's \transpose f c' writes them for
% the F mellophone with the notes. 8 placed, 0 left out.
vis_hora-chords = \chordmode {
	s4
	f1*6:m  % m1 F-
	c1*3:7  % m9 C7
	bes1*6:m  % m13 B♭-
	f1*3:m  % m21 F-
	f1*6:7  % m25 F7
	bes1*3:m  % m33 B♭-
	c1*6:7  % m37 C7
	f1*15/4:m  % m45 F-
}
