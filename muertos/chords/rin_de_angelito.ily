% rin_de_angelito-chords: the chord symbols of "Rin de Angelito Concert.pdf", read and placed on the
% card by muertos/tools/pdfchords.py (muertos/chords.sh --write); do not
% hand-edit. Concert pitch: Songs.ily's \transpose f c' writes them for
% the F mellophone with the notes. 9 placed, 0 left out.
rin_de_angelito-chords = \chordmode {
	s1*4
	g1:m  % m5 Gmin
	d1:7/g  % m6 D7/G
	d1:7/g  % m7 D7/G
	g1:m  % m8 Gmin
	bes\breve  % m9 Bb
	es1  % m11 Eb
	bes1*3  % m12 Bb
	es1  % m15 Eb
	g1:m  % m16 Gmin
}
