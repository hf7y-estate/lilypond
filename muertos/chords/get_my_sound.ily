% get_my_sound-chords: the chord symbols of "Get_My_Sound.pdf", read and placed on the
% card by muertos/tools/pdfchords.py (muertos/chords.sh --write); do not
% hand-edit. Concert pitch: Songs.ily's \transpose f c' writes them for
% the F mellophone with the notes. 4 placed, 0 left out.
get_my_sound-chords = \chordmode {
	d2:m  % m1 Dmin
	f2  % m1 F
	c4.  % m2 C
	bes1*85/8  % m2 Bb
}
